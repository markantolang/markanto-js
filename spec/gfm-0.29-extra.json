  },
  {
    "id": "gfm-strikethrough-single",
    "section": "Strikethrough (extension)",
    "markdown": "~Hi~ World!\n",
    "html": "<p><del>Hi</del> World!</p>\n"
  },
  {
    "id": "gfm-strikethrough-whitespace",
    "section": "Strikethrough (extension)",
    "markdown": "This ~~has a new\nparagraph~~.\n",
    "html": "<p>This <del>has a new\nparagraph</del>.</p>\n"
