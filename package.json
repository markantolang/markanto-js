{
  "name": "@markantolang/parser",
  "version": "0.3.0",
  "description": "Reference implementation of Markanto, a Markdown variant for robust, canonical, agent-ready documents — a tolerant parser, a canonical formatter, and a semantic-AST validator. Zero runtime dependencies.",
  "keywords": [
    "markanto",
    "markdown",
    "commonmark",
    "gfm",
    "parser",
    "formatter",
    "canonical",
    "ast",
    "markdown-parser"
  ],
  "homepage": "https://markanto.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markantolang/markanto-js.git"
  },
  "bugs": {
    "url": "https://github.com/markantolang/markanto-js/issues"
  },
  "license": "ISC",
  "author": "Michael Kortstiege",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./commonmark": {
      "types": "./dist/commonmark/index.d.ts",
      "import": "./dist/commonmark/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "markanto": "dist/cli.js"
  },
  "files": [
    "dist",
    "data/*.json",
    "data/README.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean-dist": "node scripts/clean-dist.mjs",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json && tsc -p tools/migrate/tsconfig.json && node scripts/check-compat-boundary.mjs && node scripts/check-shipped-deps.mjs",
    "corpus": "bun scripts/validate-corpus.mjs",
    "corpus:node": "node scripts/validate-corpus.mjs",
    "test": "bun test",
    "test:package": "node test/package-smoke.ts",
    "compat:report": "bun scripts/compat-report.mjs",
    "migration:audit": "bun scripts/migration-audit.ts",
    "import": "bun scripts/import.ts",
    "migrate": "bun scripts/migrate.ts",
    "verify": "./check.sh",
    "facts": "bun scripts/facts.ts",
    "check:facts": "bun scripts/facts.ts --check",
    "check:spec-sync": "bun scripts/check-spec-sync.ts",
    "audit:corpus": "bun scripts/audit-corpus.mjs",
    "audit:corpus:node": "node scripts/audit-corpus.mjs",
    "snapshots:realistic": "bun scripts/update-realistic-snapshots.ts",
    "prepublishOnly": "./check.sh",
    "bench": "node scripts/bench.mjs",
    "bench:bun": "bun scripts/bench.mjs",
    "soak": "bun scripts/soak.ts"
  },
  "peerDependencies": {
    "mdast-util-from-markdown": "2.0.2",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0"
  },
  "peerDependenciesMeta": {
    "mdast-util-from-markdown": {
      "optional": true
    },
    "mdast-util-gfm": {
      "optional": true
    },
    "micromark-extension-gfm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "marked": "^18.0.11",
    "mdast-util-from-markdown": "2.0.2",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "typescript": "5.8.3"
  }
}
