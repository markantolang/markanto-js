{
  "schemaVersion": 1,
  "group": "footnotes",
  "cases": [
    {
      "id": "footnote.basic",
      "spec": "11.2",
      "source": "Text.[^1]\n\n[^1]: Note.\n",
      "expect": {
        "normal": {
          "valid": true,
          "canonical": "Text.[^1]\n\n[^1]: Note.\n"
        },
        "strict": {
          "valid": true,
          "canonical": "Text.[^1]\n\n[^1]: Note.\n"
        }
      },
      "semanticAst": {
        "type": "document",
        "children": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "text",
                "value": "Text."
              },
              {
                "type": "footnoteReference",
                "identifier": "1"
              }
            ]
          }
        ],
        "footnotes": [
          {
            "type": "footnoteDefinition",
            "identifier": "1",
            "children": [
              {
                "type": "text",
                "value": "Note."
              }
            ]
          }
        ]
      }
    },
    {
      "id": "footnote.descriptive",
      "spec": "11.2",
      "source": "Text.[^source]\n\n[^source]: Note.\n",
      "expect": {
        "normal": {
          "valid": true,
          "canonical": "Text.[^source]\n\n[^source]: Note.\n"
        },
        "strict": {
          "valid": true,
          "canonical": "Text.[^source]\n\n[^source]: Note.\n"
        }
      }
    },
    {
      "id": "footnote.missing-definition-invalid",
      "spec": "11.3",
      "source": "Text.[^missing]\n",
      "expect": {
        "normal": {
          "valid": false,
          "diagnostics": [
            {
              "category": "semantic",
              "severity": "error"
            }
          ]
        },
        "strict": {
          "valid": false,
          "diagnostics": [
            {
              "category": "semantic",
              "severity": "error"
            }
          ]
        }
      }
    },
    {
      "id": "footnote.unused-definition-warning",
      "spec": "11.3",
      "source": "Text.\n\n[^unused]: Note.\n",
      "expect": {
        "normal": {
          "valid": true,
          "canonical": "Text.\n\n[^unused]: Note.\n",
          "diagnostics": [
            {
              "category": "advisory",
              "severity": "warning"
            }
          ]
        },
        "strict": {
          "valid": true,
          "canonical": "Text.\n\n[^unused]: Note.\n",
          "diagnostics": [
            {
              "category": "advisory",
              "severity": "warning"
            }
          ]
        }
      }
    },
    {
      "id": "footnote.definition-order-normalizes",
      "spec": "11.7",
      "source": "A.[^b] B.[^a]\n\n[^a]: A.\n[^b]: B.\n",
      "expect": {
        "normal": {
          "valid": true,
          "canonical": "A.[^b] B.[^a]\n\n[^b]: B.\n[^a]: A.\n"
        },
        "strict": {
          "valid": false,
          "diagnostics": [
            {
              "category": "noncanonical",
              "severity": "error"
            }
          ]
        }
      }
    },
    {
      "id": "footnote.identifier-case-sensitive",
      "spec": "11.3",
      "source": "A.[^A]\n\n[^a]: lower.\n",
      "expect": {
        "normal": {
          "valid": false,
          "diagnostics": [
            {
              "category": "semantic",
              "severity": "error"
            }
          ]
        },
        "strict": {
          "valid": false,
          "diagnostics": [
