    {
      "id": "resource.metadata.lang-canonical",
      "spec": "4.2",
      "source": "<m lang=DE-de>Text</m>\n",
      "expect": {
        "normal": {
          "valid": true,
          "canonical": "<m lang=de-de>Text</m>\n"
        },
        "strict": {
          "valid": false,
          "diagnostics": [
            {
              "category": "noncanonical",
              "severity": "error"
            }
          ]
        }
      },
      "semanticAst": {
        "type": "document",
        "children": [
          {
            "type": "paragraph",
            "children": [
              {
                "type": "metadataSpan",
                "attrs": {
                  "lang": "de-de"
                },
                "children": [
                  {
                    "type": "text",
                    "value": "Text"
                  }
                ]
              }
            ]
          }
        ],
        "footnotes": []
      }
