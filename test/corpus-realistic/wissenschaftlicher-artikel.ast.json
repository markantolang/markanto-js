    {
      "type": "heading",
      "level": 1,
      "children": [
        {
          "type": "text",
          "value": "Eine kurze Notiz zur Energie-Masse-Äquivalenz"
        }
      ],
      "id": "energie-masse"
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "Die berühmteste Gleichung der Physik, "
        },
        {
          "type": "inlineMath",
          "value": "E = mc^2"
        },
        {
          "type": "text",
          "value": ", verbindet Energie und"
        },
        {
          "type": "softBreak"
        },
        {
          "type": "text",
          "value": "Masse über die Lichtgeschwindigkeit. Für ruhende Körper gilt sie exakt;"
        },
        {
          "type": "softBreak"
        },
        {
          "type": "text",
          "value": "für bewegte Körper tritt der relativistische Faktor hinzu."
        },
        {
          "type": "footnoteReference",
          "identifier": "okun"
        }
      ]
    },
    {
      "type": "paragraph",
      "children": [
        {
          "type": "text",
          "value": "Aus der speziellen Relativitätstheorie folgt unmittelbar die"
        },
        {
          "type": "softBreak"
        },
        {
          "type": "text",
          "value": "Energie-Impuls-Beziehung:"
        },
        {
          "type": "footnoteReference",
          "identifier": "einstein"
        }
      ]
    },
    {
      "type": "mathBlock",
      "value": "E^2 = (pc)^2 + (m_0 c^2)^2"
    },
    {
      "type": "heading",
      "level": 2,
